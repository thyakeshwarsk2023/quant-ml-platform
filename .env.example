# Copy to .env for local development
# On Render: set these in the service Environment tab

# Neon PostgreSQL (use pooled connection string from Neon dashboard)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# production | development
ENVIRONMENT=development

# Comma-separated frontend origins (Vercel URL + local dev)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-app.vercel.app

# Optional: allow Vercel preview URLs without code changes
# CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# Optional: tune DB pool for persistent hosts such as Render
# DB_POOL_SIZE=2
# DB_MAX_OVERFLOW=2
# DB_POOL_TIMEOUT=10

# Logging: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Optional: force SSL for non-Neon hosts
# DATABASE_SSL=true

# Optional (unused by core API today)
REDIS_URL=redis://localhost:6379/0
